# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Safety-critical switches (see config/automation.yaml + README) ---
# Leaving these unset defers to config/automation.yaml (dry_run: true,
# live_mode: false), which is the safe default. Only set LIVE_MODE=true
# once you have read BUILD PROMPT sections 36-37 and mean it.
DRY_RUN=true
LIVE_MODE=false

# --- Paths ---
CONFIG_DIR=config
CANDIDATE_DIR=candidate
DATABASE_URL=sqlite:///./data/job_agent.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- LLM provider (Phase 3: semantic matching) ---
# Leave ANTHROPIC_API_KEY unset to run deterministic-only matching (safe
# default — job_agent.llm.provider falls back to NullLLMProvider and
# `jobs match` decisions are capped below APPLY without it).
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=

# --- Adzuna Jobs API (Phase 8: multi-country job search) ---
# Free credentials from https://developer.adzuna.com/. Leave both unset
# to skip the `adzuna` source entirely (logged, not an error) even if
# it's set enabled: true in config/sources.yaml — Remotive/Arbeitnow need
# no key at all and work without these.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
