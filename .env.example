# Copy this file to `.env` and fill in real values (or run `job-agent init`,
# which does this for you automatically). Never commit `.env` — it's
# already in .gitignore.

# =============================================================================
# Safety-critical switches (see config/automation.yaml + README.md)
# =============================================================================
# Purpose: the two switches that gate whether Career OS can ever submit a
#          real job application on your behalf. BOTH must be explicitly
#          DRY_RUN=false AND LIVE_MODE=true for submission to be possible.
# Required: optional — leaving them unset defers to config/automation.yaml
#          (dry_run: true, live_mode: false), which is the safe default.
# Format: DRY_RUN=true|false, LIVE_MODE=true|false
# Where to obtain: you decide these values yourself. Only set LIVE_MODE=true
#          once you have read README.md's safety-rules sections and mean it.
DRY_RUN=true
LIVE_MODE=false

# =============================================================================
# Paths
# =============================================================================
# Purpose: where Career OS reads its config/candidate files and stores its
#          database file.
# Required: optional — the defaults below are correct for a normal local
#          checkout; only change these if you deliberately relocated a
#          directory.
# Format: CONFIG_DIR/CANDIDATE_DIR are folder paths; DATABASE_URL is a
#          SQLAlchemy URL (sqlite:///./relative/path.db for a local file).
# Where to obtain: n/a — these are just paths on your own machine.
CONFIG_DIR=config
CANDIDATE_DIR=candidate
DATABASE_URL=sqlite:///./data/job_agent.db

# =============================================================================
# Logging
# =============================================================================
# Purpose: controls how much Career OS logs, and in what format.
# Required: optional — defaults are sensible for normal use.
# Format: LOG_LEVEL is one of DEBUG|INFO|WARNING|ERROR; LOG_FORMAT is
#          json|text (json is easier to pipe into log tooling, text is
#          easier to read directly in a terminal).
# Where to obtain: n/a.
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# LLM provider — Anthropic (semantic matching, resume tailoring, cover
# letters, career chat)
# =============================================================================
# Purpose: enables LLM-refined match summaries, resume-tailoring prose,
#          cover-letter drafts, and the career chat assistant. Every one of
#          these features has a fully deterministic (non-LLM) fallback, so
#          Career OS works completely without this — just with plainer text.
# Required: optional. Leave ANTHROPIC_API_KEY unset to run deterministic-only.
# Format: ANTHROPIC_API_KEY=sk-ant-... ; LLM_PROVIDER=anthropic (the only
#          supported value today); LLM_MODEL is optional, leave blank to use
#          the provider's own default model.
# Where to obtain: create a key at https://console.anthropic.com/
#          (Settings -> API Keys). Requires a funded Anthropic account —
#          real API calls cost real money; see docs/cost_audit.md.
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=

# =============================================================================
# Adzuna Jobs API (multi-country job search)
# =============================================================================
# Purpose: enables the `adzuna` job source (config/sources.yaml), which
#          searches multiple countries' job listings via Adzuna's official
#          API. Remotive and Arbeitnow need no credentials at all and work
#          without this.
# Required: optional. Leave both unset to skip the `adzuna` source entirely
#          (logged as skipped, never an error) even if it's `enabled: true`
#          in config/sources.yaml.
# Format: plain strings, no quotes — e.g. ADZUNA_APP_ID=a1b2c3d4
# Where to obtain: free credentials at https://developer.adzuna.com/ —
#          register for an account, create an "App", and copy its
#          Application ID and Application Key here.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
